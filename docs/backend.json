{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A traditional Yemeni Maawiz product",
      "type": "object",
      "properties": {
        "nameAr": { "type": "string", "description": "Product name in Arabic" },
        "nameEn": { "type": "string", "description": "Product name in English" },
        "descriptionAr": { "type": "string", "description": "Full description in Arabic" },
        "descriptionEn": { "type": "string", "description": "Full description in English" },
        "shortDescriptionAr": { "type": "string" },
        "shortDescriptionEn": { "type": "string" },
        "category": { "type": "string", "enum": ["حليسي", "ملكي", "بيضاني", "حديدي", "سلاطيني", "أخرى"] },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["available", "out_of_stock", "limited", "soon"] },
        "isFeatured": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "sku": { "type": "string" },
        "specifications": { "type": "object" }
      },
      "required": ["nameAr", "nameEn", "price", "category", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Maawiz categories",
      "type": "object",
      "properties": {
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "image": { "type": "string" },
        "slug": { "type": "string" }
      }
    },
    "Stat": {
      "title": "Association Statistic",
      "description": "Historical and organizational figures",
      "type": "object",
      "properties": {
        "labelAr": { "type": "string" },
        "labelEn": { "type": "string" },
        "value": { "type": "string" },
        "icon": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of traditional Maawiz"
    },
    "/categories": {
      "schema": "Category",
      "description": "Maawiz categories"
    },
    "/stats": {
      "schema": "Stat",
      "description": "Association statistics for the homepage"
    }
  }
}