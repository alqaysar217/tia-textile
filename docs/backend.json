
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A traditional Yemeni Maawiz product",
      "type": "object",
      "properties": {
        "nameAr": { "type": "string", "description": "Product name in Arabic" },
        "nameEn": { "type": "string", "description": "Product name in English" },
        "descriptionAr": { "type": "string", "description": "Full description in Arabic" },
        "descriptionEn": { "type": "string", "description": "Full description in English" },
        "category": { "type": "string", "enum": ["حليسي", "ملكي", "بيضاني", "حديدي", "سلاطيني", "أخرى"] },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "out_of_stock", "limited", "soon"] },
        "sku": { "type": "string" }
      },
      "required": ["nameAr", "nameEn", "price", "category", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and system role",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "factory_manager", "production_manager", "supervisor", "warehouse_keeper", "accountant", "viewer"] },
        "departmentId": { "type": "string" },
        "email": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["fullName", "role", "email"]
    },
    "Department": {
      "title": "Department",
      "description": "Production department or stage (e.g., Sewing, Dyeing)",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["code", "nameAr", "nameEn"]
    },
    "Worker": {
      "title": "Worker Profile",
      "description": "Factory worker information (Piece-rate workers)",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "workerId": { "type": "string" },
        "departmentId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "joinDate": { "type": "string", "format": "date" }
      },
      "required": ["fullName", "departmentId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of traditional Maawiz"
    },
    "/users": {
      "schema": "UserProfile",
      "description": "System users and their permissions"
    },
    "/departments": {
      "schema": "Department",
      "description": "Production departments and stages"
    },
    "/workers": {
      "schema": "Worker",
      "description": "Records of factory workers"
    }
  }
}
