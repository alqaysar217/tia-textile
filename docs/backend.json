
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A traditional Yemeni Maawiz product",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" },
        "image": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["nameAr", "price", "category", "status"]
    },
    "ProductionOrder": {
      "title": "Production Order",
      "description": "Manufacturing order for a batch of products",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "title": { "type": "string", "description": "User friendly title for the batch" },
        "productId": { "type": "string" },
        "targetQty": { "type": "number" },
        "completedQty": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "cancelled", "deleted"] },
        "priority": { "type": "string", "enum": ["low", "normal", "high"] },
        "startDate": { "type": "string", "format": "date" },
        "currentStageId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["productId", "targetQty", "status"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Inventory or financial movement document",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["material_issue", "production_receipt", "settlement", "wage"] },
        "orderId": { "type": "string" },
        "workerId": { "type": "string" },
        "departmentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "nameAr": { "type": "string" },
              "qty": { "type": "number" },
              "unit": { "type": "string" },
              "price": { "type": "number" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["posted", "cancelled"] },
        "notes": { "type": "string" }
      },
      "required": ["voucherNumber", "type", "date", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and system role",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["fullName", "role", "email"]
    },
    "Department": {
      "title": "Department",
      "description": "Production department or stage (e.g., Sewing, Dyeing)",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descAr": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["code", "nameAr"]
    },
    "Worker": {
      "title": "Worker Profile",
      "description": "Factory worker information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "workerId": { "type": "string" },
        "departmentId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoUrl": { "type": "string" },
        "joinDate": { "type": "string" },
        "active": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["fullName", "departmentId"]
    },
    "Material": {
      "title": "Raw Material",
      "description": "Raw materials used in production",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "currentQty": { "type": "number" },
        "minQty": { "type": "number" },
        "price": { "type": "number" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["code", "nameAr", "category", "unit"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/products": { "schema": "Product", "description": "Finished goods" },
    "/productionOrders": { "schema": "ProductionOrder", "description": "WIP Orders" },
    "/vouchers": { "schema": "Voucher", "description": "Inventory & Wage Documents" },
    "/users": { "schema": "UserProfile", "description": "System users" },
    "/departments": { "schema": "Department", "description": "Production stages" },
    "/workers": { "schema": "Worker", "description": "Personnel" },
    "/materials": { "schema": "Material", "description": "Inventory" }
  }
}
