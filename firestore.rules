rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالقراءة والكتابة للموظفين المسجلين دخولهم فقط
    
    match /departments/{id} {
      allow read, write: if request.auth != null;
    }
    
    match /workers/{id} {
      allow read, write: if request.auth != null;
    }
    
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
    
    match /products/{id} {
      allow read, write: if request.auth != null;
    }
  }
}