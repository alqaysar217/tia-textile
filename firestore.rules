rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالقراءة والكتابة للموظفين المسجلين دخولهم فقط لجميع المجموعات
    // هذا يضمن أن أي ميزة جديدة نضيفها (مثل المواد الخام أو أوامر الإنتاج) تعمل فوراً
    
    match /{collection}/{id} {
      allow read, write: if request.auth != null;
    }
    
    // قواعد خاصة ببيانات المستخدمين (اختياري لزيادة الأمان)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}